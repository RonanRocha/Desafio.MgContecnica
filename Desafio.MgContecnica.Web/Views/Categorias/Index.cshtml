@using Desafio.MgContecnica.Web.Helpers
@using Desafio.MgContecnica.Web.Models.Categorias


@model CategoriaViewModel

<div class="row mt-4 mb-4">
    <h1> Categorias</h1>
</div>

<div class="d-flex justify-content-end">
    <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#modalCriarCategoria">
        Nova Categoria
    </button>
</div>



@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}


<div class="card">
    <div class="card-body">
        @if (!Model.Categorias.Dados.Dados.Any())
        {
            <div class="alert alert-warning text-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Nenhum registro encontrado.
            </div>
        }
        else
        {
            <table class="table" id="categoriasTable">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nome</th>
                        <th>Tipo</th>
                        <th>Status</th>
                        <th>Data Criação</th>
                        <th>Data Atualização</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var categoria in Model.Categorias.Dados.Dados)
                    {
                        <tr>
                            <td>@categoria.Id</td>
                            <td>@categoria.Nome</td>

                            <td>
                                @if (categoria.Tipo == TipoCategoriaModel.Receita)
                                {
                                    <span class="badge bg-success">Receita</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Despesa</span>
                                }
                            </td>

                            <td>
                                @if (categoria.Status == StatusCategoriaModel.Ativo)
                                {
                                    <span class="badge bg-primary">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inativo</span>
                                }
                            </td>

                            <td>@(categoria.DataCriacao.ToString("dd/MM/yyyy"))</td>
                            <td>@(categoria.DataUltimaAtualizacao.ToString("dd/MM/yyyy"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            @Html.Pager(Model.Categorias.Dados.PaginaAtual, Model.Categorias.Dados.TotalPaginas, "Index", new { TamanhoPagina = Model.Categorias.Dados.TamanhoPagina })

        }
    </div>
</div>






<!-- Modal de criação -->
@await Html.PartialAsync("_Form", Model.CriarCategoriaModel)


@section Scripts
{

  
    @if (ViewBag.MostrarModal != null && ViewBag.MostrarModal)
    {
        <script>
            var myModal = new bootstrap.Modal(document.getElementById('modalCriarCategoria'));
            myModal.show();
        </script>
    }

    <script>
        $(document).ready(function () {
            $('.needs-validation').on('submit', function (e) {
                var form = this;
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                    $(form).addClass('was-validated');
                }
            });
        });
    </script>
}


