@using Desafio.MgContecnica.Web.Helpers
@using Desafio.MgContecnica.Web.Models.Transacoes
@using Desafio.MgContecnica.Web.Models.Categorias


@model TransacaoViewModel


<div class="row mt-4 mb-4">
    <h1> Transações</h1>
</div>


<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-end">
            <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#modalCriarTransacao">
                Nova Transação
            </button>
        </div>
    </div>
</div>


@await Html.PartialAsync("_FiltroTransacao", Model)


@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}


@if (!Model.Transacoes?.Dados?.Dados?.Any() ?? true)
{
    <div class="alert alert-warning text-center mt-5" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        Nenhum registro encontrado.
    </div>
}
else
{

    <div class="card mt-5">
        <div class="card-body">

            <div class="row">

                <div class="table-responsive">
                    <table class="table" id="categoriasTable">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Descricao</th>
                                <th>Valor</th>
                                <th>Data</th>
                                <th>Categoria</th>
                                <th>Tipo</th>
                                <th>Status Categoria</th>
                                <th>Data Criação</th>
                                <th>Data Atualização</th>
                                <th>Ações</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transacao in Model.Transacoes.Dados.Dados)
                            {
                                <tr>
                                    <td>@transacao.Id</td>
                                    <td>@transacao.Descricao</td>
                                    <td>@transacao.Valor.ToString("C")</td>
                                    <td>@transacao.Data.ToString("dd/MM/yyyy")</td>
                                    <td>@transacao.Categoria.Nome</td>

                                    <td>
                                        @if (transacao.Categoria.Tipo == TipoCategoriaModel.Receita)
                                        {
                                            <span class="badge bg-success">Receita</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Despesa</span>
                                        }
                                    </td>

                                    <td>
                                        @if (transacao.Categoria.Status == StatusCategoriaModel.Ativo)
                                        {
                                            <span class="badge bg-primary">Ativo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inativo</span>
                                        }
                                    </td>

                                    <td>@(transacao.DataCriacao.ToString("dd/MM/yyyy"))</td>
                                    <td>@(transacao.DataUltimaAtualizacao.ToString("dd/MM/yyyy"))</td>
                                    <td>
                                        <button class="btn btn-primary">Editar</button>
                                        <button class="btn btn-danger">Remover</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

              
            </div>

        


            @Html.Pager(Model.Filtro.NumeroPagina.GetValueOrDefault(), Model.Transacoes.Dados.TotalPaginas, "Index", Model.Filtro)
        </div>
    </div>


}


@await Html.PartialAsync("_FormTransacao", Model.CriarTransacaoModel)


@section Scripts {

    <script src="~/lib/bootstrap-datepicker/dist/js/bootstrap-datepicker.js"></script>
    <script src="~/lib/bootstrap-datepicker/dist/locales/bootstrap-datepicker.pt-BR.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>



    @if (ViewBag.MostrarModal != null && ViewBag.MostrarModal)
    {
        <script>
            var myModal = new bootstrap.Modal(document.getElementById('modalCriarTransacao'));
            myModal.show();
        </script>
    }

    <script>
        $(document).ready(function () {
            $('.needs-validation').on('submit', function (e) {
                var form = this;
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                    $(form).addClass('was-validated');
                }
            });


            $('.datepicker').datepicker({
                format: 'yyyy-mm-dd',
                todayHighlight: true,
                autoclose: true,
                language: 'pt-BR',   // aqui define o idioma
                orientation: "bottom"
            });


            $('.select-customizado').select2({
                theme: 'bootstrap-5',   // usa o tema adaptado para BS5
                placeholder: "Selecione uma categoria",
                allowClear: true
            });


        });
    </script>
}

