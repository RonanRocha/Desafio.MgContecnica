@using Desafio.MgContecnica.Web.Helpers
@using Desafio.MgContecnica.Web.Models.Transacoes
@using Desafio.MgContecnica.Web.Models.Categorias


@model TransacaoViewModel


<div class="row mt-4 mb-4">
    <h1> Transações</h1>
</div>


<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-end">
            <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#modalCriarTransacao">
                Nova Transação
            </button>
        </div>
    </div>
</div>


@await Html.PartialAsync("_FiltroTransacao", Model)


@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}


@if (!Model.Transacoes?.Dados?.Dados?.Any() ?? true)
{
    <div class="alert alert-warning text-center mt-5" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        Nenhum registro encontrado.
    </div>
}
else
{

    <div class="card mt-5">
        <div class="card-body">

            <div class="row">

                <div class="table-responsive">
                    <table class="table" id="categoriasTable">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Descricao</th>
                                <th>Valor</th>
                                <th>Data</th>
                                <th>Categoria</th>
                                <th>Tipo</th>
                                <th>Status Categoria</th>
                                <th>Data Criação</th>
                                <th>Data Atualização</th>
                                <th>Ações</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transacao in Model.Transacoes.Dados.Dados)
                            {
                                <tr>
                                    <td>@transacao.Id</td>
                                    <td>@transacao.Descricao</td>
                                    <td>@transacao.Valor.ToString("C")</td>
                                    <td>@transacao.Data.ToString("dd/MM/yyyy")</td>
                                    <td>@transacao.Categoria.Nome</td>

                                    <td>
                                        @if (transacao.Categoria.Tipo == TipoCategoriaModel.Receita)
                                        {
                                            <span class="badge bg-success">Receita</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Despesa</span>
                                        }
                                    </td>

                                    <td>
                                        @if (transacao.Categoria.Status == StatusCategoriaModel.Ativo)
                                        {
                                            <span class="badge bg-primary">Ativo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inativo</span>
                                        }
                                    </td>

                                    <td>@(transacao.DataCriacao.ToString("dd/MM/yyyy"))</td>
                                    <td>@(transacao.DataUltimaAtualizacao.ToString("dd/MM/yyyy"))</td>
                                    <td>
                                        <button class="btn btn-primary btn-editar" data-id="@transacao.Id">Editar</button>
                                        <button class="btn btn-danger btn-remover"  data-id="@transacao.Id">Remover</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

              
            </div>

        


            @Html.Pager(Model.Filtro.NumeroPagina.GetValueOrDefault(), Model.Transacoes.Dados.TotalPaginas, "Index", Model.Filtro)
        </div>
    </div>


}


@await Html.PartialAsync("_FormTransacao", Model.CriarTransacaoModel)

<div  id="modalContainer">
  
</div>



@section Scripts {

    <script src="~/lib/bootstrap-datepicker/dist/js/bootstrap-datepicker.js"></script>
    <script src="~/lib/bootstrap-datepicker/dist/locales/bootstrap-datepicker.pt-BR.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>



    @if (ViewBag.MostrarModal != null && ViewBag.MostrarModal)
    {
        <script>
            var myModal = new bootstrap.Modal(document.getElementById('modalCriarTransacao'));
            myModal.show();
        </script>
    }

    <script>
        $(document).ready(function () {
            $('.needs-validation').on('submit', function (e) {
                var form = this;
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                    $(form).addClass('was-validated');
                }
            });


            $('.datepicker').datepicker({
                format: 'yyyy-mm-dd',
                todayHighlight: true,
                autoclose: true,
                language: 'pt-BR',   // aqui define o idioma
                orientation: "bottom"
            });


            // $('.select-customizado').select2({
            //     theme: 'bootstrap-5',   // usa o tema adaptado para BS5
            //     placeholder: "Selecione uma categoria",
            //     allowClear: true
            // });


            $('.select-customizado').select2({
                theme: 'bootstrap-5',   // usa o tema adaptado para BS5
                placeholder: "Selecione uma categoria",
                allowClear: true,
                ajax: {
                    url: '@Url.Action("BuscarCategorias", "Transacoes")',
                    dataType: 'json',
                    delay: 500,
                    data: function (params) {
                        return {
                            busca: params.term // valor digitado pelo usuário
                        };
                    },
                    processResults: function (data) {


                        var mapped = data.results.map(function (item) {
                            return {
                                id: item.id,
                                text: item.nome,
                                tipo: item.tipo // opcional, só se precisar depois
                            };
                        });
             

                        return {
                           
                            results: mapped
                        };
                    },
                    cache: true
                }
            });


            $('.select-form-modal').select2({
                theme: 'bootstrap-5',   // usa o tema adaptado para BS5
                placeholder: "Selecione uma categoria",
                dropdownParent: $('.modal'),
                allowClear: true,
                ajax: {
                    url: '@Url.Action("BuscarCategorias", "Transacoes")',
                    dataType: 'json',
                    delay: 500,
                    data: function (params) {
                        return {
                            busca: params.term // valor digitado pelo usuário
                        };
                    },
                    processResults: function (data) {


                        var mapped = data.results.map(function (item) {
                            return {
                                id: item.id,
                                text: item.nome,
                                tipo: item.tipo // opcional, só se precisar depois
                            };
                        });


                        return {

                            results: mapped
                        };
                    },
                    cache: true
                }
            });


            $(document).on('click', '.btn-remover', function () {
                var id = $(this).data('id');

                if (confirm("Deseja realmente remover esta transação?")) {
                    $.ajax({
                        url: '@Url.Action("DeletarTransacao", "Transacoes")',
                        type: 'POST',
                        data: { id: id },
                        success: function () {
                            location.reload(); // recarrega a página após remover
                        },
                        error: function () {
                            alert("Ocorreu um erro ao tentar remover a transação.");
                        }
                    });
                }
            });


            // Abrir modal de edição
            $(document).on('click', '.btn-editar', function () {
                var id = $(this).data('id');

                $.get('@Url.Action("Editar", "Transacoes")', { id: id }, function (html) {

                    $('#modalContainer').html(html);

                    // reativa o select2 dentro do modal
                    $('.select-form-modal').select2({
                        theme: 'bootstrap-5',
                        dropdownParent: $('#modalEditarTransacao'),
                        allowClear: true,
                        ajax: {
                            url: '@Url.Action("BuscarCategorias", "Transacoes")',
                            dataType: 'json',
                            delay: 500,
                            data: function (params) {
                                return {
                                    busca: params.term // valor digitado pelo usuário
                                };
                            },
                            processResults: function (data) {


                                var mapped = data.results.map(function (item) {
                                    return {
                                        id: item.id,
                                        text: item.nome,
                                        tipo: item.tipo // opcional, só se precisar depois
                                    };
                                });


                                return {

                                    results: mapped
                                };
                            },
                            cache: true
                        }
                    });

                    var modal = new bootstrap.Modal(document.getElementById('modalEditarTransacao'));
                    modal.show();
                });
            });

            // Submit edição via AJAX
            $(document).on('submit', '#formEditarTransacao', function (e) {
                e.preventDefault();

                $.ajax({
                    url: '@Url.Action("Editar", "Transacoes")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function () {
                        location.reload();
                    },
                    error: function () {
                        alert("Erro ao editar transação.");
                    }
                });
            });


        });
    </script>
}

